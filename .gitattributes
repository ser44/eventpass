# Normalización de fin de línea: LF por defecto para que mvnw y scripts
# copiados a contenedores Linux no se rompan por CRLF (ver CLAUDE.md §13).
* text=auto eol=lf

# Scripts específicos de Windows: deben quedar en CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# El wrapper de Maven (shell) siempre en LF.
mvnw text eol=lf

# Binarios: git no los toca.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.docx binary
*.pdf binary
