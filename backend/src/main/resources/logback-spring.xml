<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- api | worker (ver app.servicio en application.yml / application-worker.yml) -->
    <springProperty scope="context" name="servicio" source="app.servicio" defaultValue="api"/>

    <!-- docker/prod: JSON para que Promtail/Loki lo indexen (incluye todo el MDC: traceId,
         spanId, userId, eventoId, reservaId, accion, motivo, duracionMs). -->
    <springProfile name="docker,prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${servicio}"}</customFields>
                <fieldNames>
                    <timestamp>ts</timestamp>
                    <message>mensaje</message>
                </fieldNames>
            </encoder>
        </appender>
    </springProfile>

    <!-- dev local: texto legible, con traceId/spanId del MDC. -->
    <springProfile name="!docker &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
