# Copiá este archivo a .env y completá los valores.
# El .env real NUNCA se commitea (está en .gitignore).

# --- Base de datos ---
DB_PASSWORD=eventpass

# --- Seguridad: JWT HS256, mínimo 32 bytes ---
JWT_SECRET=cambiar-esta-clave-por-una-de-32-bytes-o-mas

# --- Perfil Spring activo (api | worker ; se combinan con dev/demo/docker) ---
SPRING_PROFILES_ACTIVE=docker

# --- SMTP (Mailpit en desarrollo) ---
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Reglas de reserva ---
APP_RESERVA_TTL_MINUTOS=10

# --- Grafana (stack de observabilidad) ---
GRAFANA_ADMIN_PASSWORD=admin
